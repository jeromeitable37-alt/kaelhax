rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true;
    }

    match /site/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.disabled == false;

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.disabled == resource.data.disabled
        );

      allow delete: if isAdmin();

      /*
       * CUSTOMER FEEDBACK
       * Users can only read their own feedback.
       * A feedback document can only be created by its owner
       * and only when it references their own confirmed order.
       */
      match /feedback/{feedbackId} {
        allow read: if signedIn()
          && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userId == uid
          && request.resource.data.verifiedPurchase == true
          && request.resource.data.orderId is string
          && exists(
            /databases/$(database)/documents/orders/$(request.resource.data.orderId)
          )
          && get(
            /databases/$(database)/documents/orders/$(request.resource.data.orderId)
          ).data.userId == uid
          && get(
            /databases/$(database)/documents/orders/$(request.resource.data.orderId)
          ).data.status == 'confirmed';

        /*
         * The current UI does not update or delete feedback,
         * so keep submitted feedback immutable.
         */
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }
  }
}