rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.disabled != true;
    }

    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && userId == request.auth.uid;
    }

    match /payment/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && userId == request.auth.uid;
    }
  }
}
